{% with foam_class="dictionary", foam_object="controlDict" %}
{% include "foam_header.jinja" %}
{% endwith %}

application     simpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         {{ spec.solve.max_iterations }};
deltaT          1;
writeControl    runTime;
// Falls back to max_iterations, i.e. write once at the end. Anything that
// stops the run another way - a timeout above all - then leaves no fields
// behind at all, so set solve.write_interval on long runs.
writeInterval   {{ spec.solve.write_interval or spec.solve.max_iterations }};
purgeWrite      2;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable false;

functions
{
    forceCoeffs
    {
        type            forceCoeffs;
        libs            ("libforces.so");
        writeControl    timeStep;
        writeInterval   1;
        log             true;

        patches         ({% for p in force_patches %}{{ p }} {% endfor %});

        rho             rhoInf;
        rhoInf          {{ spec.flow.rho }};
        magUInf         {{ spec.flow.u_inf }};
        lRef            {{ spec.forces.l_ref }};
        Aref            {{ a_ref }};

        // Drag acts along the flow and the side axis completes a
        // right-handed set with it, so both follow flow.direction. Leaving
        // dragDir at +x with the tunnel reversed reports a negative Cd.
        liftDir         (0 0 1);
        dragDir         {{ drag_dir }};
        pitchAxis       {{ pitch_axis }};
        CofR            ({{ spec.forces.c_of_r[0] }} {{ spec.forces.c_of_r[1] }} {{ spec.forces.c_of_r[2] }});
    }

    // FORCES IN NEWTONS AND MOMENTS IN NEWTON-METRES.
    //
    // forceCoeffs above reports coefficients only, and a report that gets
    // pasted into a spreadsheet wants dimensional numbers. Recovering them
    // from Cd/Cs/Cl would mean assuming how OpenFOAM maps CmRoll, CmPitch
    // and CmYaw onto Cartesian axes; this object writes x, y and z
    // components directly and there is nothing left to guess.
    //
    // AGGREGATE ONLY. The per-patch split the report needs is a split of
    // *coefficients*, which forceCoeffs_<patch> below already supplies.
    // Eleven more force objects would add eleven directories and no
    // information.
    //
    // v2412 writes force.dat and moment.dat as ten tab-separated columns:
    // Time, then total, pressure and viscous vector triples in that order
    // (forces.C::writeIntegratedDataFileHeader). No porosity here, so there
    // is no fourth triple. run/parsers.py::read_force_vectors depends on it.
    forces
    {
        type            forces;
        libs            ("libforces.so");
        writeControl    timeStep;
        writeInterval   1;
        log             false;

        patches         ({% for p in force_patches %}{{ p }} {% endfor %});

        rho             rhoInf;
        rhoInf          {{ spec.flow.rho }};
        CofR            ({{ spec.forces.c_of_r[0] }} {{ spec.forces.c_of_r[1] }} {{ spec.forces.c_of_r[2] }});
    }

    // The same coefficients again, one function object per force patch.
    //
    // The aggregate above says the car's Cl oscillates; it cannot say which
    // part of the car is doing it. A limit cycle fed by the rear wing stalling
    // and one fed by the front tyre wake look identical in the total, and they
    // want opposite fixes. These split the total by patch so the trace can be
    // attributed before anyone re-tunes numerics against it.
    //
    // Aref, lRef and CofR are deliberately the aggregate's, NOT a per-patch
    // frontal area. That makes each patch's Cd and Cl its *share* of the
    // vehicle coefficient, so they sum to the total and can be read against
    // it directly. Per-patch areas would give eleven numbers on eleven
    // different scales that add up to nothing.
    //
    // Cost is a surface integral per patch per iteration, which is noise
    // against the solve - but it is eleven more directories under
    // postProcessing/, so anything globbing forceCoeffs* needs to expect them.
{% for p in force_patches %}
    forceCoeffs_{{ p }}
    {
        type            forceCoeffs;
        libs            ("libforces.so");
        writeControl    timeStep;
        writeInterval   1;
        log             false;

        patches         ({{ p }});

        rho             rhoInf;
        rhoInf          {{ spec.flow.rho }};
        magUInf         {{ spec.flow.u_inf }};
        lRef            {{ spec.forces.l_ref }};
        Aref            {{ a_ref }};

        liftDir         (0 0 1);
        dragDir         {{ drag_dir }};
        pitchAxis       {{ pitch_axis }};
        CofR            ({{ spec.forces.c_of_r[0] }} {{ spec.forces.c_of_r[1] }} {{ spec.forces.c_of_r[2] }});
    }
{% endfor %}
    yPlus
    {
        type            yPlus;
        libs            ("libfieldFunctionObjects.so");
        executeControl  writeTime;
        writeControl    writeTime;
        log             true;
    }

    // AREA-WEIGHTED y+, ONE PER WALL PATCH, AND THE GATE READS THESE RATHER
    // THAN THE OBJECT ABOVE.
    //
    // `yPlus` reports an unweighted mean over the faces of a patch, counting
    // a tiny face and a huge one equally. How wrong that is depends on how y+
    // correlates with face size on the patch, and THE DIRECTION IS NOT
    // UNIVERSAL. Measured on car-nut10-smooth:
    //
    //     ground    face-mean 10.37   area-weighted 20.65   +99%
    //     SUS_FL    face-mean  1.130  area-weighted  1.031   -9%
    //
    // The ground is bimodal - many tiny refined faces under the car at low
    // y+, a few huge bare faces far out at high y+ - so its unweighted mean
    // is dragged down and reports half the real number. On the vehicle the
    // correlation reverses and it reads slightly high. Either way it is the
    // wrong average, and the ground is the patch it is badly wrong on.
    //
    // DECLARED AFTER `yPlus` ON PURPOSE. surfaceFieldValue reads yPlus out of
    // the object registry, function objects execute in dictionary order, and
    // the other order finds nothing and reports nothing - with no error.
    // executeControl on both is writeTime so they fire together.
{% for p in wall_patches %}
    yPlusArea_{{ p }}
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        regionType      patch;
        name            {{ p }};
        operation       areaAverage;
        fields          (yPlus);
        writeFields     false;
        executeControl  writeTime;
        writeControl    writeTime;
        log             false;
    }
{% endfor %}

{% if spec.solve.average_fields %}
    // TIME-AVERAGED FIELDS, AND WITHOUT THEM A SLICE IS A SNAPSHOT.
    //
    // This case does not reach a fixed point. It reaches a stationary mean and
    // oscillates about it, which is why every coefficient above is reported as
    // a mean over the trailing window rather than as a final value. The fields
    // had no equivalent: a Cp or Cpt slice taken off a time directory sampled
    // one arbitrary phase of that cycle. Comparing two designs that way
    // compares two arbitrary phases of two different limit cycles, and it
    // manufactures differences in flow structure that are pure sampling.
    //
    // Body and Wing carry 89% of this case's Cl oscillation (see
    // results/components_Cl.png), so the error lands hardest on exactly the
    // surfaces under development.
    //
    // timeStart IS THE FORCE WINDOW'S OWN START, so <field>Mean and the
    // reported Cd/Cl describe the same iterations. A run stopped before
    // timeStart therefore has no average at all - which is correct, because it
    // also has no trustworthy coefficient.
    fieldAverage
    {
        type            fieldAverage;
        libs            ("libfieldFunctionObjects.so");
        writeControl    writeTime;
        timeStart       {{ average_time_start }};
        restartOnRestart false;
        restartOnOutput  false;

        fields
        (
{% for f in spec.solve.average_fields %}
            {{ f }}
            {
                mean        on;
                prime2Mean  off;
                base        time;
            }
{% endfor %}
        );
    }

{% endif %}
    residuals
    {
        type            solverInfo;
        libs            ("libutilityFunctionObjects.so");
        writeControl    timeStep;
        writeInterval   1;
        fields          (U p k omega);
    }
}
