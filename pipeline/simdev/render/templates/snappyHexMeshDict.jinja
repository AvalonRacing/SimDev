{% with foam_class="dictionary", foam_object="snappyHexMeshDict" %}
{% include "foam_header.jinja" %}
{% endwith %}

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
{% for patch in refined_patches %}
    {{ patch.name }}
    {
        type            triSurfaceMesh;
        file            "{{ patch.file }}";
    }
{% endfor %}
{% for volume in refinement_volumes %}
    // A closed volume used ONLY to refine the cells inside it. Deliberately
    // absent from refinementSurfaces, like the two distance surfaces below:
    // it creates no patch, is never snapped to, and never enters force
    // integration. Putting it there without a cellZone would make it a wall.
    {{ volume.name }}
    {
        type            triSurfaceMesh;
        file            "{{ volume.file }}";
    }
{% endfor %}
{% for box in refinement_boxes %}
    {{ box.name }}
    {
        type            searchableBox;
        min             ({{ box.min[0] }} {{ box.min[1] }} {{ box.min[2] }});
        max             ({{ box.max[0] }} {{ box.max[1] }} {{ box.max[2] }});
    }
{% endfor %}
{% if shell_surface %}
    // The whole vehicle as one surface, used ONLY to measure distance from
    // for the refinement shells below. It is deliberately absent from
    // refinementSurfaces, so it creates no patch, is never snapped to, and
    // never enters force integration - adding it there would duplicate every
    // wall in the model.
    {{ shell_surface }}
    {
        type            triSurfaceMesh;
        file            "{{ shell_surface }}.stl";
    }
{% endif %}
{% if wake_surface %}
    // A surface swept along the cornering arc, used ONLY to measure distance
    // from for the wake shells below - same exclusions as the vehicle
    // surface above, just following the path instead of the car.
    {{ wake_surface }}
    {
        type            triSurfaceMesh;
        file            "{{ wake_surface }}.stl";
    }
{% endif %}
}

castellatedMeshControls
{
    maxLocalCells       2000000;
    maxGlobalCells      50000000;
    minRefinementCells  10;
    nCellsBetweenLevels 3;
    resolveFeatureAngle 30;
    allowFreeStandingZoneFaces true;

    // How far the per-rank cell counts may drift before snappy redistributes
    // the mesh mid-refinement. Rendered explicitly because the balancing
    // policy is a property of this case, not of whichever build runs it.
    //
    // It matters here far more than the value suggests. decomposePar splits
    // the *background* mesh, which is uniform, so the 40 ranks start with an
    // equal share of a domain in which the refinement is then poured into a
    // ball a few tenths of a metre across: essentially every cell of the
    // finished mesh is created by the handful of ranks that happen to own the
    // car, while the rest hold empty tunnel and idle. Rebalancing is what
    // spreads the next iteration's work back out, and how often it happens is
    // this number.
    //
    // Related trap, which is why the value is not simply set as loose as
    // possible: maxLocalCells is a SILENT refinement stop, not an error. A
    // rank that hits it stops refining and snappy carries on, so a badly
    // unbalanced run can quietly return a mesh coarser than the one that was
    // asked for.
    maxLoadUnbalance    {{ spec.mesh.max_load_unbalance }};

    features
    (
{% for patch in refined_patches %}
        {
            file    "{{ patch.name }}.eMesh";
            level   {{ patch.level_max }};
        }
{% endfor %}
    );

    refinementSurfaces
    {
{% for patch in refined_patches %}
        {{ patch.name }}
        {
            level   ({{ patch.level_min }} {{ patch.level_max }});
{% if patch.is_cell_zone %}
            // A closed volume rather than a wall. Its faces stay internal so
            // flow passes through them, and the cells it encloses become a
            // cellZone for constant/MRFProperties to rotate. No boundary
            // patch is created, which is why nothing writes a boundary
            // condition for this name.
            cellZone        {{ patch.name }};
            faceZone        {{ patch.name }};
            cellZoneInside  inside;
{% endif %}
        }
{% endfor %}
    }

    refinementRegions
    {
{% for volume in refinement_volumes %}
        {{ volume.name }}
        {
            mode            inside;
            // For 'inside' the distance is ignored; only the level applies.
            levels          ((1.0 {{ volume.level }}));
        }
{% endfor %}
{% for box in refinement_boxes %}
        {{ box.name }}
        {
            mode            inside;
            // For 'inside' the distance is ignored; only the level applies.
            levels          ((1.0 {{ box.level }}));
        }
{% endfor %}
{% if shell_surface and refinement_shells %}
        // Shells of refinement at a distance from the vehicle itself, rather
        // than inside a box someone drew round it. The refined volume is
        // therefore the shape of the car: it needs no orientation, so it is
        // correct for a cornering wake and a body-slip attitude alike, and it
        // reaches into the gaps between body, chassis and suspension where a
        // box only ever refines the air around them.
        //
        // Listed nearest-first because snappy applies the first entry whose
        // distance contains the cell; coarsest-first, the outer shell would
        // swallow the inner ones. context.refinement_shells sorts them.
        {{ shell_surface }}
        {
            mode            distance;
            levels          (
{% for shell in refinement_shells %}
                                ({{ "%.6f"|format(shell.distance) }} {{ shell.level }})
{% endfor %}
                            );
        }
{% endif %}
{% if wake_surface and wake_shells %}
        // Same idea as the vehicle shells above, at a distance from the
        // curved wake surface instead: refines the shape of the corner's
        // wake rather than a box, which is what lets it follow the path
        // without needing an orientation of its own. context.wake_shells
        // sorts them, same reason as refinement_shells.
        {{ wake_surface }}
        {
            mode            distance;
            levels          (
{% for shell in wake_shells %}
                                ({{ "%.6f"|format(shell.distance) }} {{ shell.level }})
{% endfor %}
                            );
        }
{% endif %}
    }

    locationInMesh ({{ location_in_mesh[0] }} {{ location_in_mesh[1] }} {{ location_in_mesh[2] }});
}

snapControls
{
    nSmoothPatch    3;
    tolerance       2.0;
    nSolveIter      50;
    nRelaxIter      5;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes false;
    expansionRatio {{ spec.mesh.expansion_ratio }};
    firstLayerThickness {{ spec.mesh.first_layer_thickness }};
    minThickness {{ spec.mesh.first_layer_thickness / 4 }};

    layers
    {
{% for patch in layer_patches %}
        {{ patch.name }}
        {
            nSurfaceLayers {{ patch.n_layers }};
        }
{% endfor %}
    }

    nGrow               0;
    featureAngle        130;
    nRelaxIter          5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals      3;
    nSmoothThickness    10;
    maxFaceThicknessRatio {{ spec.mesh.max_layer_cell_ratio }};
    // snappy's default is 0.3, which caps the stack at 30% of the distance to
    // the medial axis. On a 0.44 m car that is punitive: the suspension links
    // are 4-6 mm sections, so their medial axis is ~2 mm from the surface and
    // 0.3 leaves 0.6 mm of budget that the quality relaxation then eats into.
    // 0.6 is the usual value for external aero with thin appendages.
    maxThicknessToMedialRatio 0.6;
    minMedialAxisAngle  90;
    nBufferCellsNoExtrude 0;
    nLayerIter          50;
    // Layer iterations that run under the strict meshQualityControls before
    // snappy falls back to the `relaxed` sub-dictionary below.
    //
    // MEASURED AT PRODUCTION RESOLUTION, AND 0 IS THE WRONG ANSWER HERE.
    // snappyLayerDriver selects the dictionary as
    // `iteration < nRelaxedIter ? strict : relaxed`, so 0 puts the relaxed
    // limits in force for iteration 0 - the iteration that decides which
    // faces get extruded at all. The relaxed block sets minVol, minTetQuality
    // and minDeterminant to ~1e-30, and with those in force from the start
    // snappy extrudes the full 40 um stack over the whole 18.8 m2 of
    // far-field track, where the background cell is 96 mm wide:
    //
    //   nRelaxedIter 1 -> ground 3.37 layers, max aspect ratio 79, OK
    //   nRelaxedIter 0 -> ground 5.71 layers, max aspect ratio 3238, FAILED
    //
    // Those extra layers resolve nothing. The ground that matters is the 0.8%
    // under the car, which the refinement shells reach and which is layered
    // either way (21 um vs 24 um). The rest is still air over bare tarmac.
    //
    // RE-MEASURED 2026-08-29 ON THE 48 mm BACKGROUND, and the shape holds:
    //
    //   nRelaxedIter 1 -> ground 1.89 layers, max aspect ratio  252, FAILED
    //   nRelaxedIter 0 -> ground 5.91 layers, max aspect ratio 2609, FAILED
    //                     (aspect, 16,095 cells of 2.88 M), +7.6% cells
    //
    // "resolve nothing" was too strong, and worth correcting: those layers do
    // fix the ground's y+, which is 12.40 area-weighted and rises with
    // distance because the unlayered far field has its first cell centre
    // ~24 mm up. 0 extrudes the designed 25 um first layer and would put the
    // far field under y+ 2. It is still not taken, because what it buys is a
    // wall treatment on bare tarmac that no reported force depends on, and
    // what it costs is a checkMesh aspect-ratio failure. See the ground patch
    // note in cases/car/config.yaml for the full measurement.
    nRelaxedIter        {{ spec.mesh.n_relaxed_iter }};
}

meshQualityControls
{
    maxNonOrtho         {{ spec.mesh.max_non_ortho }};
    maxBoundarySkewness 20;
    maxInternalSkewness {{ spec.mesh.max_skewness }};
    maxConcave          80;
    minVol              1e-13;
    minTetQuality       1e-15;
    minArea             -1;
    minTwist            0.02;
    minDeterminant      0.001;
    minFaceWeight       0.02;
    minVolRatio         0.01;
    minTriangleTwist    -1;

    // The fallback snappy uses from nRelaxedIter onwards, for layer insertion
    // only. It is not a second opinion on the finished mesh, which checkMesh
    // and the mesh gate judge for themselves.
    //
    // maxNonOrtho AND maxSkewness STAY AT THE STRICT VALUES, and that was
    // tested rather than assumed. The theory was that the layer driver answers
    // a failed criterion by scaling layer DISPLACEMENT down rather than by
    // rejecting the mesh, so a stricter limit here should cost thickness.
    // Running the production mesh at 75/8 against 70/4, one variable changed:
    //
    //   Body, Chassis, Wing and all four SUS came out bit-for-bit identical
    //   Tire_FL 3.09 vs 3.08 layers, i.e. inside run-to-run noise
    //   severely non-orthogonal faces DOUBLED, 72 -> 144
    //
    // So it buys nothing on this geometry and costs mesh quality. The tyre
    // improvement that arrived in the same session was the refinement change
    // (refinement_min 6 -> 7), not this.
    //
    // WHAT RELAXING THE REST DID NOT DO, EITHER: buy layers. Tet-quality
    // rejections fell from 104,773 to 25 and minDeterminant's 584,674 to 0,
    // and layer coverage moved 59.37% -> 59.47%. Kept only because a steady
    // finite-volume solve never uses the tet decomposition - but see
    // nRelaxedIter above, because letting these apply from iteration 0 is
    // exactly what plastered the far-field ground with sliver layers.
    //
    // Every key is written out even where it repeats the strict value, so
    // this block does not depend on what snappy inherits for a missing one.
    relaxed
    {
        // Judged by the gate: strict. See the note on this block.
        maxNonOrtho         {{ spec.mesh.max_non_ortho }};
        maxInternalSkewness {{ spec.mesh.max_skewness }};
        maxBoundarySkewness 20;
        maxConcave          80;

        // Criteria a steady finite-volume solve never uses.
        minVol              1e-30;
        minTetQuality       1e-30;
        minArea             1e-30;
        minTwist            0.001;
        minDeterminant      1e-06;
        minFaceWeight       1e-06;
        minVolRatio         0.001;
        minTriangleTwist    -1;
    }

    nSmoothScale        4;
    errorReduction      0.75;
}

mergeTolerance 1e-6;
