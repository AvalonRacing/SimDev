{% with foam_class=foam_class, foam_object=field %}
{% include "foam_header.jinja" %}
{% endwith %}

dimensions      {{ dimensions }};

internalField   {{ internal_field }};

boundaryField
{
    // Default types for OpenFOAM's constraint patches. Required for parallel
    // runs: decomposePar splits the domain along procBoundary* patches that
    // exist only in the decomposed mesh, so no case-level field file can
    // name them, and simpleFoam aborts with "Cannot find patchField entry
    // for procBoundary0to1" without this. Explicit entries below override it.
    #includeEtc "caseDicts/setConstraintTypes"

{% for bc in bcs %}
    {{ bc.patch }}
    {
{% for key, value in bc.entries.items() %}
        {{ key }}{{ ' ' * (16 - key|length) }}{{ value }};
{% endfor %}
    }
{% endfor %}
}
