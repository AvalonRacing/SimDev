# OpenFOAM dictionaries and shell/python scripts are POSIX text files
# (read on Linux/WSL/clusters) - normalize everything to LF by default.
* text=auto eol=lf

# Windows-native scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - never diff/convert.
*.png -text
*.jpg -text
*.jpeg -text
*.pdf -text
